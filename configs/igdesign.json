{
  "name": "igdesign",
  "source": {
    "kind": "loader",
    "hook": "autoresearch_filters.datasets:igdesign",
    "kwargs": {
      "cache_dir": "../data/downloads"
    }
  },
  "id_column": "candidate_id",
  "label_column": "Binder",
  "success_value": true,
  "group_column": "system",
  "signals": {
    "HCDR3 scRMSD (ABB2)": {
      "direction": "lower_is_better",
      "range": [
        0,
        10
      ],
      "units": "angstrom",
      "description": "Public precomputed structural self-consistency RMSD; a smaller deviation is preferred.",
      "missing": {
        "policy": "drop"
      }
    },
    "HCDR3 scRMSD (ABB3)": {
      "direction": "lower_is_better",
      "range": [
        0,
        10
      ],
      "units": "angstrom",
      "description": "Public precomputed structural self-consistency RMSD; a smaller deviation is preferred.",
      "missing": {
        "policy": "drop"
      }
    },
    "HCDR3 scRMSD (ESMFold)": {
      "direction": "lower_is_better",
      "range": [
        0,
        10
      ],
      "units": "angstrom",
      "description": "Public precomputed structural self-consistency RMSD; a smaller deviation is preferred.",
      "missing": {
        "policy": "drop"
      }
    },
    "Fv scRMSD (ABB2)": {
      "direction": "lower_is_better",
      "range": [
        0,
        10
      ],
      "units": "angstrom",
      "description": "Public precomputed structural self-consistency RMSD; a smaller deviation is preferred.",
      "missing": {
        "policy": "drop"
      }
    }
  },
  "exclude_columns": [
    "KD (nM)",
    "Binding Replicates",
    "Replicates",
    "Ratio Binding Replicates",
    "Method",
    "Target",
    "Reference Ab",
    "HCDR1",
    "HCDR2",
    "HCDR3",
    "HCDRs Designed"
  ],
  "split": {
    "holdout": "group",
    "holdout_groups": [
      "Utomilumab-TNFRSF9"
    ],
    "dev": "logo",
    "folds": 3,
    "repeats": 5,
    "seed": 1729,
    "verification": "split_positive"
  },
  "protocol": {
    "top_k": [
      5,
      10,
      20
    ],
    "max_fpr": 0.1,
    "sign_policy": "warn",
    "guard_tolerance": 0.01,
    "primary_metric": "roc_auc",
    "search_budget": 12
  }
}
