    },
    "boltz_rosetta_A_BC_iptm": {
      "direction": "higher_is_better",
      "range": [
        0.07,
        0.94
      ],
      "missing": "error",
      "description": "Boltz binder-target interface predicted TM-score."
    },
    "boltz_plddt_binder_none": {
      "direction": "higher_is_better",
      "range": [
        0.28,
        0.94
      ],
      "missing": "error",
      "description": "Boltz predicted binder local confidence."
